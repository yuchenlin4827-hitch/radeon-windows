<?xml version="1.0" encoding="utf-8"?>
<!--
  rokmd.vcxproj — Radeon Open Kernel Mode Driver（WDDM 2.0 骨架）
  依赖仓库根目录的 packages.config + Directory.Build.props
  （WDK NuGet，微软官方 CI 方案，见 docs/roadmap.md M0）。

  结构遵循 WDK 样例工程标准顺序：
    Globals → Microsoft.Cpp.Default.props → Configuration 组
    → Microsoft.Cpp.props → ItemDefinitionGroup → 源文件 → Microsoft.Cpp.targets
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{7A4C1B65-93E2-4F1A-9C57-2E1D8A54B0F3}</ProjectGuid>
    <ProjectName>rokmd</ProjectName>
    <RootNamespace>rokmd</RootNamespace>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <!-- 注意：WindowsTargetPlatformVersion 在 Configuration 组里显式设置为
         10.0.26100.0（与 WDK NuGet 版本一致），使 WDKBinRoot 解析到
         packages\...\c\bin\10.0.26100.0（stampinf 等工具所在目录）。 -->
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>WindowsApplicationForDrivers10.0</PlatformToolset>
    <DriverType>WDM</DriverType>
    <TargetVersion>WINDOWS10</TargetVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsApplicationForDrivers10.0</PlatformToolset>
    <DriverType>WDM</DriverType>
    <TargetVersion>WINDOWS10</TargetVersion>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <PropertyGroup Label="UserMacros" />

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <!-- 源码含中文注释，强制 UTF-8 编译，避免代码页告警 -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NTDDI_VERSION=NTDDI_WIN10;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!--
        WDK NuGet 布局下的显式 include 路径（工具链自动组装在 CI 上不可靠）：
        - WDK 包 c\Include\<ver>\{km, km\crt, shared}：ntddk/wdm/dispmprt、内核 CRT、d3dkmddi
        - SDK 包 c\Include\<ver>\{um, shared, ucrt}：um 头、d3dukmdt/d3dkmthk、UCRT
        WDKContentRoot/RokSdkContentRoot 在 Directory.Build.props 中指向 NuGet 包布局，
        CI 亦可经 /p: 全局属性覆盖。
      -->
      <AdditionalIncludeDirectories>$(WDKContentRoot)Include\10.0.26100.0\km;$(WDKContentRoot)Include\10.0.26100.0\km\crt;$(WDKContentRoot)Include\10.0.26100.0\shared;$(RokSdkContentRoot)Include\10.0.26100.0\um;$(RokSdkContentRoot)Include\10.0.26100.0\shared;$(RokSdkContentRoot)Include\10.0.26100.0\ucrt;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <TreatLinkerWarningAsErrors>false</TreatLinkerWarningAsErrors>
      <AdditionalLibraryDirectories>$(WDKContentRoot)Lib\10.0.26100.0\km\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <Inf>
      <TreatWarningAsError>false</TreatWarningAsError>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\driver.c" />
    <ClCompile Include="src\adapter.c" />
    <ClCompile Include="src\ddi.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="src\precomp.h" />
    <ClInclude Include="src\adapter.h" />
    <ClInclude Include="src\ddi.h" />
    <ClInclude Include="src\rok_escape.h" />
  </ItemGroup>
  <ItemGroup>
    <Inf Include="rokmd.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
